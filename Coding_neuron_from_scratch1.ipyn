      "source": [
        "# first neuron in python"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#what is a neuron\n",
        "# a neuron is unit which take input(s) and deliver outputs and with each input we attach weights and add a bias term to the whole value"
      ],
      "metadata": {
        "id": "uMK9roiEZ3Y3"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#neuron with 3 inputs\n",
        "\n",
        "input = [6, 3, 2]\n",
        "weights = [0.5, -0.5, -0.8]\n",
        "bias = 0.4\n",
        "output = input[0]*weights[0] + input[1]*weights[1] + input[2]*weights[2] + bias\n",
        "print(output)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ZjPJpEHaaRLM",
        "outputId": "51520b13-cc4f-4c96-ab01-353ddd1462c4"
      },
      "execution_count": 9,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "0.29999999999999993\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#neuron with 4 inputs\n",
        "\n",
        "input = [4, 5, 23, -60]\n",
        "weights = [0.4, 0.5, 0.1, 0.02]\n",
        "bias = 22\n",
        "output = input[0]*weights[0] + input[1]*weights[1] + input[2]*weights[2] + input[3]*weights[3]\n",
        "print(output)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "zY8krnAhdJaS",
        "outputId": "e97a1baa-a1f1-47ba-f0b7-69bd194d4d3b"
      },
      "execution_count": 12,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "5.2\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# neural layer with 4 inputs and 3 neurons\n",
        "\n",
        "input = [2.3, 4.3, 7.3, 3.4]\n",
        "weights = [[0.3, 0.5, -0.4, 0.7],\n",
        "           [0.5, 0.1, 0.33, 0.55],\n",
        "           [0.8, 0.22, 0.43, 0.01]]\n",
        "\n",
        "weights1 = weights[0]\n",
        "weights2 = weights[1]\n",
        "weights3 = weights[2]\n",
        "\n",
        "bias = [1,4,7]\n",
        "\n",
        "output = [\n",
        "# 1st neuron:\n",
        "input[0]*weights1[0] +\n",
        "input[1]*weights1[1] +\n",
        "input[2]*weights1[2] +\n",
        "input[3]*weights1[3] + bias[0],\n",
        "#2nd neuron\n",
        "input[0]*weights2[0] +\n",
        "input[1]*weights2[1] +\n",
        "input[2]*weights2[2] +\n",
        "input[3]*weights2[3] + bias[1],\n",
        "#3rd neuron\n",
        "input[0]*weights3[0] +\n",
        "input[1]*weights3[1] +\n",
        "input[2]*weights3[2] +\n",
        "input[3]*weights3[3] + bias[2] ]\n",
        "\n",
        "print(output)\n",
        "\n",
        "# here we obtained output for 3 different neurons where 1st neuron gives 3.3, 2nd neuron gives 9.859, 3rd gives 12.959\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "4B3sR-CfhGpp",
        "outputId": "81cf0a13-5f56-4ac3-cb95-49e7bbec08c0"
      },
      "execution_count": 17,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "[3.3, 9.859, 12.959]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Caluculating neuron output using loops\n",
        "\n",
        "input = [2.3, 4.3, 7.3, 3.4]\n",
        "weight = [[0.3, 0.5, -0.4, 0.7],\n",
        "           [0.5, 0.1, 0.33, 0.55],\n",
        "           [0.8, 0.22, 0.43, 0.01]]\n",
        "bias = [1,4,7]\n",
        "\n",
        "#output of the current layer\n",
        "layer_output = []\n",
        "\n",
        "for neuron_weights, neuron_bias in zip(weight, bias):\n",
        "  neuron_output = 0\n",
        "  for n_input, weight in zip(input, neuron_weights):\n",
        "    neuron_output += n_input*weight\n",
        "  neuron_output += neuron_bias\n",
        "  layer_output.append(neuron_output)\n",
        "\n",
        "print(layer_output)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "V7wPQhu3jf0n",
        "outputId": "e5a47783-d96d-47f6-e364-0e3d892b906f"
      },
      "execution_count": 18,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "[3.3, 9.859, 12.959]\n"
          ]
        }
      ]
    }
  ]
